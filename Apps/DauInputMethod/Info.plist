<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Unlocalized names must equal the bundle file name (ASCII, technical id) or Finder
	     treats the bundle as renamed and ignores the localized name. The user-visible name
	     "Dấu" (D24) comes from Resources/InfoPlist.xcstrings (vi and en). -->
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>GPLv3</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>DauAppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- Host app (Dấu, Settings) opened by the input menu's "Cài đặt Dấu…". -->
	<key>DauHostAppBundleIdentifier</key>
	<string>$(BUNDLE_ID_PREFIX)</string>

	<!-- Input Method Kit -->
	<key>InputMethodConnectionName</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>DauInputController</string>
	<key>TISInputSourceID</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>TISIntendedLanguage</key>
	<string>vi</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Latn</string>
	</array>
	<!-- Icons: monochrome template TIFF (16 pt @1x + @2x), generated by
	     scripts/make-mode-icons.sh. TextServices.h documents .tif/.icns, paths relative to
	     Resources. TISIconIsTemplate is not in the public headers but every built-in IMK input
	     method that ships monochrome icons sets it (AinuIM, TamilIM, PluginIM on macOS 27).
	     TODO(M7): official identity files (docs/BRAND.md). -->
	<key>tsInputMethodIconFileKey</key>
	<string>ModeVietnamese.tiff</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<!-- One input mode, "Dấu – Tiếng Việt" (D2, 30/10/2026; the old ".en" mode is gone,
	     English is typed with the system's ABC/U.S. source). The mode is kept, rather than
	     declaring the bundle alone, so the input source ID users already enabled
	     ("….Dau.vi") does not change and the source stays in the Vietnamese group.
	     Input mode IDs are literal: Xcode does not expand build settings in plist keys.
	     They must start with this bundle's identifier. When BUNDLE_ID_PREFIX changes in
	     project.yml, update every "com.example.dau.inputmethod.Dau.vi" here AND the matching
	     key in Resources/InfoPlist.xcstrings (display name "Dấu – Tiếng Việt"). -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.example.dau.inputmethod.Dau.vi</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>com.example.dau.inputmethod.Dau.vi</string>
				<key>tsInputModeMenuIconFileKey</key>
				<string>ModeVietnamese.tiff</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>ModeVietnamese.tiff</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>ModeVietnamese.tiff</string>
				<!-- Undocumented: Apple's TamilIM declares a text label per mode this way
				     (macOS 27). Kept so the system can draw its own label if it prefers it. -->
				<key>TISIconLabels</key>
				<dict>
					<key>Primary</key>
					<string>V</string>
				</dict>
				<key>TISIntendedLanguage</key>
				<string>vi</string>
				<key>tsInputModeScriptKey</key>
				<string>smRoman</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.example.dau.inputmethod.Dau.vi</string>
		</array>
	</dict>
</dict>
</plist>
