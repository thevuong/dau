<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
	<!-- "Chọn ứng dụng khác…" (Ứng dụng › add rule): NSOpenPanel refuses to open in the
	     sandbox without it. Read-only, and only the app the user picks. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Read-only access to the user's input-source shortcut (Settings > Gõ phím, D2):
	     AppleSymbolicHotKeys 60/61 and AppleFnUsageType; and to the option "Automatically
	     switch to a document's input source" (Settings > Ứng dụng, D5):
	     AppleGlobalTextInputProperties. Never written (N4). -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>com.apple.symbolichotkeys</string>
		<string>com.apple.HIToolbox</string>
	</array>
</dict>
</plist>
